// === Variables & Mixins
*
    --container-indent 20px


$notebook = 1368px
$tablet = 912px
$mobile = 576px

$text-color = #000000
$purple-color = #9564AA
$pink-color = #C15CA1
$yellow-color = #FFCF2D
$brown-color = #AA6464

purple-style()
    display flex
    flex-direction column
    gap 22px 0
    background-color rgba(($purple-color), 0.1)
    border 2px solid rgba(($purple-color), 0.2)
    padding 18px
    border-radius 10px

body
    display flex
    flex-direction column
    color $text-color
    height 100vh
    &._lock
        overflow hidden
        touch-action none
h1
    font-size 20px
    font-weight 700
    line-height 23px
    @media (min-width $tablet)
        font-size 40px
        line-height 45.96px

h2
    font-size 16px
    line-height 18px
h3
    font-size 12px
    line-height 14px
h4
    font-size 10px
    line-height 16px
h5
    font-size 10px
    line-height 11.49px

p
    font-size 12px
    line-height 13.79px

._container
    margin 0 auto
    padding 0 var(--container-indent)
    @media (min-width: $notebook)
        max-width 1172px
.wrapper
    width 100vw
    display flex
    flex-direction column
    padding-bottom 30px
    @media (min-width: $tablet)
        flex-direction row
        align-items flex-start
        justify-content center
        margin 30px auto
        gap 30px
.header
    position relative
    background-color $purple-color
    padding 6px 0
    width 100%
    z-index 2
    &__container
        display flex
        align-items center
    &__logo
        display none
    &__menu
        overflow-y auto
    @media (min-width $tablet)
        padding 23px 0
        &__container
            display flex
            align-items center
        &__logo
            display inline-block
            margin-right auto
            font-size 48px
            font-weight 700
            line-height 55.15px
            color white


.menu
    transition .2s
    background-color white
    display flex
    flex-direction column
    width 100vw
    height 100vh
    padding 55px var(--container-indent) 24px
    gap 20px 0
    &__link
        transition .2s
        &:hover
            opacity .6
    &__item._premium
        padding 10px
        .menu__link
            font-size 0
        .menu__icon
            font-size 20px


    &__list
        display flex
        align-items center
        width 100%
        purple-style()
    // &__item

    @media (max-width:  $tablet)
        top 0
        position fixed
        left -100%
        &__list
            align-items flex-start
            flex-direction column
        &._active
            left 0
    @media (min-width $mobile)
        width fit-content
        box-shadow 4px 4px 8px 0px rgba(34, 60, 80, 0.2)
    @media (min-width $tablet)
        width auto
        height auto
        padding 0
        margin-left auto
        background-color transparent
        box-shadow unset
        &__list
            width fit-content
            flex-direction row
            padding 0
            gap 40px
        &__item
            font-size 16px
            color white
            font-weight 700
            &._premium
                display flex
                align-items center
                color $yellow-color
                background-color #684677
                border-radius 10px
                padding 7px 13px
                .menu__link
                    font-size inherit
        &__link
            display flex
            align-items center
            gap 10px
.burger
    display none
    margin-right auto

    @media (max-width:  $tablet)
        display flex
        flex-direction column
        align-items center
        justify-content center
        z-index: 2;
        position: relative;
        --width: 23px
        --height 14px
        --heightItem 2px
        height var(--height)
        &::before, div, &::after
            content ''
            width var(--width)
            height var(--heightItem)
            background white
            transition margin .2s ease .2s, transform .2s, width .2s

        &::before
            margin 0 0 calc((var(--height) - var(--heightItem) * 3) / 2 ) 0

        &::after
            margin calc((var(--height) - var(--heightItem) * 3) / 2 ) 0 0 0

        &._active
            &::before, div, &::after
                transition margin .2s ease 0s, transform .2s ease .2s
                background-color $purple-color

            &::before
                margin 0 0 calc(-1 * var(--heightItem)) 0
                transform rotate(45deg)

            div
                transform rotate(135deg)

            &::after
                margin calc(-1 * var(--heightItem)) 0 0 0
                width 0


.title
    width 100%
    padding-bottom 10px
    border-bottom 2px solid rgba($purple-color, .2)
    margin: 15px 0 23px
    @media (min-width $tablet)
        &__text
            filter drop-shadow(4px 4px 0 #00000040)


.sidebar
    purple-style()
    width 100%
    &__devider
        width 100%
        height 1px
        background-color $purple-color
        opacity .2
    @media (min-width $tablet)
        width fit-content
        height 100%


.content
    max-width 100%
    flex 1
.discount
    display none
    @media (min-width $notebook)
        display flex
        align-items center
        background-color $pink-color
        padding 13px
        border-radius 10px
        width 100%
        justify-content space-between
        margin-bottom 26px
        &__title
            text-shadow 1px 1px 1px white
            letter-spacing 0.04em
            color $yellow-color
        &__text
            color white
            font-weight 700

.timer
    display flex
    background-color white
    border-radius 5px
    padding 5px 20px
    &__value
        font-weight 400
    &__devider
        margin 0 10px

.list
    display flex
    flex-direction column
    gap 25px 0
    &__link
        display flex
        align-items center
        gap 29px
        transition .2s
        &:hover
            color $purple-color
.profile
    display grid
    gap 5px 15px
    width fit-content
    align-items center
    grid-template-areas 'img name' \
                        'img premium'
    &__img
        grid-area img
        width 49px
        height 49px
        border-radius 50%
        overflow hidden
    &__name
        grid-area name
        font-weight 700
    &__premium
        grid-area premium
        color white
        background-color $purple-color
        border-radius 5px
        padding 5px 10px
.offers
    max-width 100%
    margin-bottom 32px
    &__list, &__btn
        margin-bottom 15px
    &__item._main .offer__container
        display flex
        flex-direction row
        background-color rgba($brown-color, .2)
        border-radius 10px
        border 2px solid $brown-color

    @media (min-width $tablet)
        --count 3
        --indentX 30px
        --indentY 15px
        --item-width calc((100% - ((var(--count) - 1) * var(--indentX))) / var(--count))
        width 100%
        &__list
            display flex
            align-items flex-start
            flex-wrap wrap
            gap var(--indentY) var(--indentX)
        &__item
            min-width var(--item-width)
            flex 1 1 var(--item-width)

        &__checkbox
            margin-top 15px
        &__btn
            display none
    @media (min-width $notebook)
        --count 5

.slick
    &-list
        max-width 100%
    &-track
        gap 10px
    &-dots
        display flex !important
        justify-content center
        align-items center
        margin-top  10px
        li
            padding 4px

    &-dot
        min-width 7px
        min-height 7px
        border-radius 50%
        background-color $yellow-color

.offer
    --leftIndent: 20px
    --sidesPadding: 32px
    align-items center
    flex-direction column
    max-width 100%
    &__container
        display flex
        align-items center
        background-color rgba($purple-color, .1)
        color $text-color
        padding 16px var(--sidesPadding)
        border-radius 10px
        border 2px solid $purple-color
        transition .2s
        justify-content center
    &__note
        font-size 14px
        line-height 1
        color $text-color
        padding 3px 10px
        border-radius 5px
        background-color $yellow-color
        font-weight 700
        margin-left calc(-1 * (var(--leftIndent) + var(--sidesPadding)))
    &__price
        display flex
        align-items center
        line-height 1
        font-size 24px
        font-weight 700
        line-height 27.58px

    &__currency
        font-size 8px
        line-height 7px
        font-weight 700
        display inline-flex
        align-items center
        justify-content center
        border-radius 50%
        width 17px
        height 17px
        margin -2% 2px 0 5px
        color $text-color
        background-color $yellow-color
    &__btn
        display none
    &._stock
        padding 0 0 0 var(--leftIndent)
        .offer__container
            background-color $purple-color
            color white
        .offer__price
            margin-left auto
    &:hover
        .offer__container
            background-color $purple-color
            color white

    @media (min-width $tablet)
        &__container
            flex-direction column
            align-items  center
            position relative
            gap 10px
        &__note
            position absolute
            top -10px
            z-index 1
            margin-left 0
        &__other
            display none
        &__btn
            display flex
            padding 17px 28px
            border-radius 5px
            font-size 16px
            font-weight 600
            line-height 18.38px
            background-color white
            color rgba($text-color, .2)
            transition .2s

        &._stock
            padding 0
            .offer__container
                background-color $purple-color
                color white
            .offer__price
                margin-left 0
            .offer__btn
                background-color $yellow-color
                color $text-color

        &._main
            .offer__container
                flex-direction column
        &:hover
            .offer__container
                background-color $purple-color
            .offer__btn
                color $text-color
                background-color $yellow-color
    @media (min-width $notebook)
        &._main
            .offer__container
                flex-direction row
                gap 40px
.btn
    display flex
    align-items center
    justify-content center
    background-color $yellow-color
    border-radius 10px
    font-size 16px
    line-height 18px
    font-weight 700
    width 100%
    padding 18px

.checkbox
    align-items flex-start
    position relative
    p
        font-size 10px
        line-height 16px
    a
        display inline
        color $purple-color

    input
        display none

    label
        display flex
        align-items flex-start
        gap 10px

    label::before
        background-color white
        content ''
        display inline-block
        min-width 18px
        max-width 18px
        min-height 18px
        max-height 18px
        border 1px solid $purple-color
        cursor pointer
        transition .2s
        border-radius 5px

    label::after
        cursor pointer
        position absolute
        left 4px
        top 5px
        z-index 1
        content '\e909'
        font-family icons
        font-size 8px
        transition .2s
        opacity 0
        color white

    input:checked + label::after
        opacity 1

    input:checked + label::before
        background-color $purple-color

    &._error
        label::before
            border 1px solid red

    @media (min-width $mobile)
        label::after, label::before
            margin-top: -2px


.benefits
    --circle-radius 120px
    display flex
    flex-direction column
    height calc(var(--circle-radius) * 2 + 60px)
    &__img
        align-self center
        margin-bottom 13px
    &__list
        display flex
        flex-direction column
        gap 10px 0
    &__item
        display flex
        align-items center
        font-weight 700
        gap 5px 10px
        z-index 1

    &__text
        color $purple-color
        font-weight 700
    &__icon
        display flex
        align-items center
        justify-content center
        min-width 30px
        height 30px
        background-color rgba($purple-color, 0.1)
        border-radius 50%
        i::before
            transition .2s
        &:hover
            i::before
                color $yellow-color
    //.circle
    //    height calc(var(--circle-radius) * 2 + 100px)
    @media (min-width $mobile)
        align-items center
        &__list
            height 0
        &__item
            flex-direction column
            text-align center
        &__icon
            min-width 50px
            height 50px
            font-size 20px
        &__text
            position absolute
            top 100%
            width 110px
        &__img
            position absolute
            margin-bottom -25%
            img
                min-width 120px
.circle
    display none
    @media (min-width $mobile)
        display flex
        align-items center
        justify-content center
        position relative
        &__svg
            max-width calc(var(--circle-radius)*2)
            height calc(var(--circle-radius)*2)
            width calc(var(--circle-radius)*2)
            overflow visible
            z-index -1
            margin auto
        &__anim
            fill none
            stroke-width 0
.background
    display none
    @media (min-width: $notebook)
        display flex
        align-items center
        justify-content center
        width 100vw
        height 100vh
        position fixed
        left 0
        top 0
        opacity 0.7
        pointer-events none
