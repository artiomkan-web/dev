@font-face 
    font-family 'icons'
    src  url('fonts/icons.eot?aa9m0j')
    src  url('fonts/icons.eot?aa9m0j#iefix') format('embedded-opentype'),
      url('fonts/icons.ttf?aa9m0j') format('truetype'),
      url('fonts/icons.woff?aa9m0j') format('woff'),
      url('fonts/icons.svg?aa9m0j#icons') format('svg')
    font-weight normal
    font-style normal
    font-display block
  
i 
  font-family 'icons' !important
  speak never
  font-style normal
  font-weight normal
  font-variant normal
  text-transform none
  line-height 1

  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale
  &::before
    display inline-flex
  



