// Media
img
  max-width 100%
  height auto
  vertical-align middle
.video
  position relative
  padding-bottom 56.25%
  height 0
  overflow hidden
.video iframe,
.video object,
.video embed
  position absolute
  top 0
  left 0
  width 100%
  height 100%
// General
*
  padding 0
  border 0
  margin 0
  align-items baseline
  box-sizing border-box
  text-decoration none
  font-family Ubuntu
  font-weight 400
  line-height 1.25
  list-style-type none
  background-position center center
  background-repeat no-repeat
  background-size cover
  border-collapse separate
  border-spacing unset
  animation-fill-mode forwards
  scroll-behavior smooth
a, input, button, textarea
  display inline-block
  outline none

a, span
  color inherit
  line-height inherit
  letter-spacing inherit
  position relative
  font-size inherit
  font-family inherit
  font-weight inherit
  
button
  background none
  cursor pointer

.slick
  &-list
    overflow hidden
  &-track
      display flex
      align-items flex-start
      gap: 1px;